# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	.mechatron-prime/targets = Exact-commit Mechatron targets for offline Linux package and tests
	INTENT.md = Stable purpose, scope, constraints, and success criteria for future agents
	PLAN.md = Remaining implementation milestones and links to maintenance history
	README.md = Fork purpose, Zig/Nix usage, release gate, and preserved upstream documentation
	build-all = Build the five supported CLI targets without mixing outputs
	build-checked = Live upstream-release preflight before Nix or direct Zig builds
	build-cli = Checked target/profile build and verified platform entrypoint publication
	corruption-coverage = Fixed corruption-reader campaigns with replay evidence and simultaneous 95% intervals
	doc/CLI.md = C CLI data formats, build commands and JSON diagnostic contract
	doc/CORRUPTION_COVERAGE.md = Corruption experiment design, confidence bounds, provenance and limitations
	doc/FORK_MAINTENANCE.md = Consumer status mapping and mutation-test maintenance guidance
	docs/PLAN_LOG.md = Completed development tasks retired from PLAN.md
	docs/plan_context/stream-parser.md = Decided contract for the forward-only Lerc2 validator
	flake.lock = Pinned Nix inputs for repeatable toolchain and package builds
	run = Build and run the native CLI while preserving binary stdout
	scripts/check-upstream-release = Fail-closed check of bundled codec version against latest Esri release
	scripts/coverage-summary.jq = Exact binomial confidence bounds and outcome classification
	src/LercLib/Lerc.cpp = Each decoded band must consume its declared blob, so a checksum-skipped version mutation fails
	src/LercLib/Lerc2.cpp = Uncompressed tile samples are copied by byte count so a misaligned blob does not trap
	src/LercLib/include/Lerc_stream.h = C ABI for the stream validation report, including an optional mask
	src/cli.c = C CLI over the public LERC ABI; bounded streams, JSON diagnostics, masks and samples
	src/lercz.zig = Thin LERC C API import, public constants, round-trip and dimension-limit regression tests
	src/stream_parser.c = Forward-only Lerc2 validator: headers, checksums, RLE masks, constants, one-sweep
	test = Run the offline gate tests and Zig codec tests
	tests/cli/build-cli = Publication target classifier, failure preservation and stdout isolation
	tests/cli/codec = CLI and independent C ABI interop acceptance tests
	tests/cli/coverage = Real corruption-reader integration and adverse-outcome classification tests
	tests/cli/upstream-release = Offline version-ordering and build-gate enforcement tests
	tests/ffi/reference.c = Independent C caller for CLI encode/decode interoperability
	tests/ffi/stream.c = Oracle differential tests for the stream validation API
	tests/unit/coverage = Independent reference checks for exact binomial interval math
]
